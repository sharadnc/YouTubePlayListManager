# =============================================================================
# YouTube Playlist Manager (.env)
# PURPOSE: OAuth client credentials and local paths for YTPM.
#
# FIRST-RUN SETUP (full guide: docs/oauth-setup.md):
# 1. Create a Google Cloud project.
# 2. Enable "YouTube Data API v3" (APIs & Services → Library).
# 3. Configure OAuth consent screen; add yourself as a Test user while in Testing.
# 4. Create OAuth 2.0 Client ID (Desktop app) under APIs & Services → Credentials.
# 5. Copy Client ID and Client Secret into this file (not into token.json).
# 6. Set YTPM_VENV to your Python virtualenv root (source .bat launchers only).
# 7. Prefer Run_YTPM.vbs (silent GUI). Or Run_YTPM_CLI.bat auth.
#    Launchers install missing packages automatically (ensure_deps).
#    YTPM creates token.json automatically after browser consent.
# =============================================================================

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_TOKEN_PATH=./token.json
YTPM_LIST_DIR=./list_mode
YTPM_EXPORT_DIR=./exports

# Virtualenv root used by Run_YTPM.bat / Run_YTPM_CLI.bat / Build_YTPM.bat.
# Must contain Scripts\python.exe and Scripts\pythonw.exe.
# Launchers run ensure_deps.py on startup and pip-install any missing packages.
# Packaged YTPM.exe ignores YTPM_VENV. For a team zip, see docs/distribute.md
# (Build_YTPM.bat --zip). Do not share token.json.
YTPM_VENV=C:\PythonVenvs\venv
